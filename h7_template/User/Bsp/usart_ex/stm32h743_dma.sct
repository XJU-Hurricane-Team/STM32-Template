; STM32H743II: keep DMA buffers out of DTCM and startup zero initialization.
LR_IROM1 0x08000000 0x00200000 {
    ER_IROM1 0x08000000 0x00200000 {
        *.o (RESET, +First)
        *(InRoot$$Sections)
        .ANY (+RO)
    }
    RW_DMA 0x30000000 UNINIT 0x00048000 {
        * (.bss.dma_buffer)
    }
    RW_IRAM1 0x20000000 0x00020000 {
        .ANY (+RW +ZI)
    }
    RW_IRAM2 0x24000000 0x00080000 {
        .ANY (+RW +ZI)
    }
}
